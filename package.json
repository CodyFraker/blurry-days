{
  "name": "grainydays-drinking-game",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "ci:docker": "docker compose -f docker-compose.ci.yml run --rm ci bash scripts/ci-github-test.sh",
    "ci:local": "bash scripts/ci-local.sh",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:ensure": "tsx scripts/ensure-database.ts",
    "db:migrate": "npm run db:ensure && tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@fontsource/oswald": "^5.2.6",
    "@radix-ui/react-dialog": "^1.1.14",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.5.1",
    "fast-xml-parser": "^5.2.5",
    "googleapis": "^133.0.0",
    "next": "^15.3.4",
    "next-auth": "^5.0.0-beta.25",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.7",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  }
}
